{
  "name": "@storybook/react-docgen-typescript-plugin",
  "version": "1.0.1",
  "description": "A webpack plugin to inject react typescript docgen information.",
  "license": "MIT",
  "repository": "storybookjs/react-docgen-typescript-plugin",
  "author": "Andrew Lisowski <lisowski54@gmail.com>",
  "main": "dist/index.js",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build:example": "npm run build && webpack",
    "build": "tsc -p tsconfig.build.json",
    "start": "yarn build --watch",
    "lint": "biome check",
    "lint:fix": "biome check --write --unsafe",
    "test": "npm run test:v5",
    "pretest:v5": "add-no-save webpack@5",
    "test:v5": "jest",
    "release": "auto shipit"
  },
  "keywords": [
    "react",
    "docgen",
    "typescript",
    "webpack",
    "plugin"
  ],
  "files": [
    "dist"
  ],
  "dependencies": {
    "debug": "^4.1.1",
    "endent": "^2.0.1",
    "find-cache-dir": "^3.3.1",
    "flat-cache": "^6.1.10",
    "micromatch": "^4.0.2",
    "react-docgen-typescript": "^2.1.1",
    "tslib": "^2.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/debug": "^4.1.5",
    "@types/find-cache-dir": "^3.2.0",
    "@types/jest": "^29.5.14",
    "@types/micromatch": "^4.0.1",
    "@types/node": "^24.0.1",
    "@types/react": "^17.0.0",
    "auto": "^10.3.0",
    "jest": "^30.0.0",
    "memfs": "^3.2.2",
    "memory-fs": "^0.5.0",
    "react": "^17.0.1",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.1.2",
    "typescript": "^5.8.3",
    "webpack": "^5.36.2",
    "webpack-cli": "^4.7.0",
    "yarn-add-no-save": "^1.0.3"
  },
  "peerDependencies": {
    "typescript": ">= 5.x",
    "webpack": ">= 5"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
